{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teacher Studio",
  "version": "0.1.0",
  "identifier": "com.teacherstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Teacher Studio",
      "width": 1440,
      "height": 940,
      "minWidth": 800,
      "minHeight": 600,
      "resizable": true,
      "backgroundColor": "#f6f8f9"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Your offline teaching workspace",
    "category": "Education",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" }
    }
  }
}
